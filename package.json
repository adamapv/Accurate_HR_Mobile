{
  "name": "accurate-hr-mobile",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "typecheck": "tsc --noEmit",
    "sync:shared": "node scripts/sync-shared.mjs",
    "check:shared": "node scripts/check-shared.mjs",
